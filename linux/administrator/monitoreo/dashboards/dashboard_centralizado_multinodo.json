        }
      ],
      "title": "Salud Espejo LVM RAID 1 (Worker Web)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "CERRADO (BLOQUEADO)" }, "1": { "color": "green", "text": "ABIERTO (ACTIVO)" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
