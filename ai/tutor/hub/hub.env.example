# Configuración del hub MCP. Copiar a hub.env (está en .gitignore) y editar.
#   cp ai/tutor/hub/hub.env.example ai/tutor/hub/hub.env
# Cualquier variable definida en el entorno le gana a este archivo.

# --- Dónde están los otros repos -------------------------------------------------
# Carpeta que contiene (o va a contener) study-cybercirujas, rag-tutor y oss-docs-mcp.
# Por defecto: la carpeta padre de este repo (o sea, repos hermanos de labs).
#HUB_REPOS_DIR=/home/alumno/repos

# Qué servidores usar (ids de hub.json separados por espacio). Por defecto: todos.
#HUB_SERVERS=labs study

# --- Red -------------------------------------------------------------------------
# 127.0.0.1 = solo esta máquina (por defecto).  0.0.0.0 = toda la red (modo clase).
#HUB_BIND=0.0.0.0
# Obligatorio con HUB_BIND=0.0.0.0. Generar con: python3 ai/tutor/hub/hub.py token
#HUB_TOKEN=
# Nombre o IP con que los alumnos llegan a esta máquina (se usa al generar configs).
#HUB_PUBLIC_HOST=192.168.1.50

# --- Usar un MCP de otra máquina en vez de levantarlo acá (modo alumno) ----------
# Ejemplo: rag-tutor y oss-docs los sirve el docente.
#HUB_URL_RAG_TUTOR=http://192.168.1.50:8093/mcp
#HUB_TOKEN_RAG_TUTOR=
#HUB_URL_OSS_DOCS=http://192.168.1.50:8094/mcp
#HUB_TOKEN_OSS_DOCS=

# --- Open WebUI (hub.py webui up) -------------------------------------------------
#WEBUI_PORT=3000
# false = sin login, solo escucha en esta máquina. true = con usuarios (obligatorio
# para abrirlo a la red; el primero que se registra queda como administrador).
#WEBUI_AUTH=false
# Modelo local con Ollama (tiene que saber llamar herramientas: qwen2.5:7b o mayor).
#OLLAMA_BASE_URL=http://127.0.0.1:11434
# Modelo en la nube compatible con OpenAI (por ejemplo OpenRouter).
#OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
#OPENAI_API_KEY=
# Modelo base para 'hub.py webui agent' (si no, usa el primero que vea Open WebUI).
#WEBUI_BASE_MODEL=qwen2.5:7b
# Clave de API de Open WebUI: solo hace falta para 'webui agent' con WEBUI_AUTH=true.
#WEBUI_API_KEY=
# Cualquier otra variable de Open WebUI: prefijo OWUI_ (OWUI_DEFAULT_LOCALE=es -> DEFAULT_LOCALE=es).
#OWUI_DEFAULT_LOCALE=es
